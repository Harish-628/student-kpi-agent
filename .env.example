# Environment Template - Student KPI Management System
# Copy this file to .env and fill in your values

# Database Configuration
DATABASE_URL=sqlite:///./student_kpi.db

# JWT & Security Configuration
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=true
API_WORKERS=1

# CORS Configuration
CORS_ORIGINS=http://localhost:8080,http://localhost:3000,http://localhost

# Logging Configuration
LOG_LEVEL=INFO
LOG_FILE=./logs/app.log

# Application Configuration
APP_NAME=Student KPI Management System
APP_VERSION=1.0.0
APP_DEBUG=false

# Email Configuration (Optional)
EMAIL_ENABLED=false
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SENDER_EMAIL=noreply@studentkpi.com

# Upload Configuration
MAX_UPLOAD_SIZE=10485760
UPLOAD_DIRECTORY=./uploads

# Analytics Configuration
ENABLE_ANALYTICS=true
ANALYTICS_RETENTION_DAYS=365

# Demo Data Configuration
CREATE_DEMO_DATA=true
DEMO_USER_COUNT=4

# Feature Flags
ENABLE_MOBILE_APP=false
ENABLE_AI_RECOMMENDATIONS=false
ENABLE_EMAIL_NOTIFICATIONS=false

# Third-party Services (Optional)
OPENAI_API_KEY=
LANGCHAIN_API_KEY=
CHROMADB_PATH=./vector_db

# Gemini API Key (Required for AI Chatbot)
GEMINI_API_KEY=

# SerpApi Key (Required for Events Recommendations)
SERPAPI_API_KEY=

# Development Configuration
TESTING_MODE=false
SEED_DATABASE=true

# Configurable KPI Category Weights
KPI_WEIGHT_INTERNSHIPS=25.0
KPI_WEIGHT_CERTIFICATIONS=15.0
KPI_WEIGHT_HACKATHONS=20.0
KPI_WEIGHT_PUBLICATIONS=25.0
KPI_WEIGHT_WORKSHOPS=5.0
KPI_WEIGHT_PROJECTS=10.0
